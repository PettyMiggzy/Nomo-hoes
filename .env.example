# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Venice (https://venice.ai) -- powers gnome chat and image generation.
VENICE_API_KEY=
VENICE_CHAT_MODEL=venice-uncensored-role-play
VENICE_IMAGE_MODEL=lustify-v8

# Postgres (Neon) -- credits, message usage, payment ledger.
DATABASE_URL=

# Chain the NOMO token lives on. The RPC must serve this chain ID.
CHAIN_ID=4663
ROBINHOOD_RPC=
NOMO_CONTRACT=0xfD036176739e03BaB9E5eA881069Ca2845e5c0de
# Optional: minimum NOMO held to sign in (0 = any wallet, no RPC needed).
MIN_NOMO=0

# The pool wallet: users top up credits by sending USDG here, and creator
# cash-outs are paid from it. Payments are disabled until this is set.
TREASURY_ADDRESS=
# USDG (Global Dollar) on Robinhood Chain; defaults to the official mainnet
# contract 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168.
USDG_CONTRACT=
PAYMENT_MIN_CONFIRMATIONS=2

JWT_SECRET=change_me_to_a_long_random_string

# Owner login at /owner -- no wallet needed, unlimited use. 16+ chars;
# the login is disabled if this is unset.
OWNER_PASSWORD=

# Pricing (all optional; defaults shown). Change in Vercel, then redeploy.
# Everything is priced in credits, and 1 credit = 1 USDG = $1.
# Free limits are per wallet (or guest IP) per day, across all gnomes.
GUEST_FREE_MESSAGES=5
WALLET_FREE_MESSAGES=10
VIP_FREE_MESSAGES=50
MESSAGES_PER_BATCH=10
CREDITS_PER_BATCH=0.25
CREDITS_PER_IMAGE=0.1
# Suggested top-up packs in USDG (any amount works).
PACK_TASTER_USD=5
PACK_GARDENER_USD=20
PACK_LORD_USD=50

# Self-serve ads (/advertise): AD_PRICE_CREDITS for AD_DAYS once approved.
AD_PRICE_CREDITS=25
AD_DAYS=7

# Creators (/creator, /marketplace, paid DMs): buyers pay in credits;
# PLATFORM_CUT_BPS is the platform's share (2000 = 20%), the rest goes to the
# creator's earnings, which they cash out 1:1 in USDG (min MIN_CASHOUT) via
# the owner's payout queue at /owner/payouts.
PLATFORM_CUT_BPS=2000
CREATOR_MIN_PRICE=0.5
DM_MIN_PRICE=0.05
MIN_CASHOUT=10
# Default price for new premium photos / clips on gnome pages
# (each item is repriceable later in /owner/premium).
PREMIUM_PHOTO_PRICE=1
PREMIUM_CLIP_PRICE=3

# VIP Pass: spend VIP_PRICE_CREDITS, or burn VIP_PRICE_NOHOES $NOHOES to
# 0x...dEaD. The burn option is disabled until NOHOES_CONTRACT is set.
NOHOES_CONTRACT=
VIP_PRICE_CREDITS=9.99
VIP_PRICE_NOHOES=0.069
VIP_DAYS=30

# Dashboard only: Venice's flat per-image cost.
VENICE_IMAGE_COST_USD=0.01
