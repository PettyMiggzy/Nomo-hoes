# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# The /cellmate chatbot (src/app/api/chat/route.ts) uses whichever of
# these is set. If both are set, Groq is preferred.

# Groq (https://console.groq.com) -- faster/cheaper once you have a key.
GROQ_API_KEY=
GROQ_MODEL=

# Venice (https://venice.ai) -- works today as a drop-in fallback.
VENICE_API_KEY=
VENICE_MODEL=
