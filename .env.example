# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Venice (https://venice.ai) -- powers gnome chat and image generation.
# Required. Groq/OpenAI-style providers won't do NSFW, so Venice is the
# only supported provider here.
VENICE_API_KEY=
VENICE_CHAT_MODEL=venice-uncensored-role-play
VENICE_IMAGE_MODEL=lustify-v8

# Wallet gate (chain 4663 / "Robinhood Chain").
ROBINHOOD_RPC=
NOMO_CONTRACT=0xfd036176739e03bab9e5ea881069ca2845e5c0de
MIN_NOMO=1000
JWT_SECRET=change_me_to_a_long_random_string

# Chat/image pricing.
FREE_MESSAGES=10
MESSAGES_PER_NOMO=20
NOMO_PER_BATCH=0.2
NOMO_PER_IMAGE=0.5
