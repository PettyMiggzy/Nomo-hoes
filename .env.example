# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Venice (https://venice.ai) -- powers gnome chat and image generation.
VENICE_API_KEY=
VENICE_CHAT_MODEL=venice-uncensored-role-play
VENICE_IMAGE_MODEL=lustify-v8

# Postgres (Neon) -- credits, message usage, payment ledger.
DATABASE_URL=

# Chain the NOMO token lives on. The RPC must serve this chain ID.
CHAIN_ID=4663
ROBINHOOD_RPC=
NOMO_CONTRACT=0xfD036176739e03BaB9E5eA881069Ca2845e5c0de
# Optional: minimum NOMO held to sign in (0 = any wallet, no RPC needed).
MIN_NOMO=0

# Wallet that receives NOMO payments for credits. Payments are disabled
# until this is set.
TREASURY_ADDRESS=
PAYMENT_MIN_CONFIRMATIONS=2

JWT_SECRET=change_me_to_a_long_random_string

# Owner login at /owner -- no wallet needed, unlimited use. 16+ chars;
# the login is disabled if this is unset.
OWNER_PASSWORD=

# Pricing (all optional; defaults shown). Change in Vercel, then redeploy.
# Free limits are per wallet (or guest IP) per day, across all gnomes.
GUEST_FREE_MESSAGES=5
WALLET_FREE_MESSAGES=10
VIP_FREE_MESSAGES=50
MESSAGES_PER_BATCH=10
NOMO_PER_BATCH=0.025
NOMO_PER_IMAGE=0.05
PACK_GARDENER_NOMO=0.5
PACK_LORD_NOMO=2

# Self-serve ad marketplace (/advertise): pay AD_PRICE_NOMO to run an image
# or short video ad for AD_DAYS, once approved at /owner/ads.
AD_PRICE_NOMO=5
AD_DAYS=7

# Creator marketplace (/creator, /marketplace): creators sell AI-generated
# gnome scenes for NOMO. PLATFORM_CUT_BPS is the platform's share of every
# sale (2000 = 20%); the rest is sent straight to the creator's wallet.
PLATFORM_CUT_BPS=2000
CREATOR_MIN_PRICE_NOMO=0.02
# Default NOMO price for new premium photos / clips on gnome pages
# (each item is repriceable later in /owner/premium).
PREMIUM_PHOTO_NOMO=0.1
PREMIUM_CLIP_NOMO=0.3
# Creator DMs: floor for the per-message price creators set themselves.
DM_MIN_PRICE_NOMO=0.001

# Creator ID documents are AES-256-GCM encrypted before storage. Set a long
# random value here; if unset the key is derived from JWT_SECRET (so rotating
# JWT_SECRET would make existing ID documents unreadable).
ID_DOC_KEY=

# VIP Pass: pay VIP_PRICE_NOMO to the treasury, or burn VIP_PRICE_NOHOES
# $NOHOES to 0x...dEaD. The burn option is disabled until NOHOES_CONTRACT is set.
NOHOES_CONTRACT=
VIP_PRICE_NOMO=1
VIP_PRICE_NOHOES=0.069
VIP_DAYS=30

# Dashboard only (does not affect on-chain amounts): what to assume NOMO
# is worth in USD when showing revenue, and Venice's flat per-image cost.
NOMO_PRICE_USD=7
VENICE_IMAGE_COST_USD=0.01
