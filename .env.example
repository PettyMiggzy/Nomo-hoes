# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Venice (https://venice.ai) -- powers gnome chat and image generation.
VENICE_API_KEY=
VENICE_CHAT_MODEL=venice-uncensored-role-play
VENICE_IMAGE_MODEL=lustify-v8

# Postgres (Neon) -- credits, message usage, payment ledger.
DATABASE_URL=

# Chain the NOMO token lives on. The RPC must serve this chain ID.
CHAIN_ID=4663
ROBINHOOD_RPC=
NOMO_CONTRACT=0xfD036176739e03BaB9E5eA881069Ca2845e5c0de
# Optional: minimum NOMO held to sign in (0 = any wallet, no RPC needed).
MIN_NOMO=0

# Wallet that receives NOMO payments for credits. Payments are disabled
# until this is set.
TREASURY_ADDRESS=
PAYMENT_MIN_CONFIRMATIONS=2

JWT_SECRET=change_me_to_a_long_random_string

# Owner login at /owner -- no wallet needed, unlimited use. 16+ chars;
# the login is disabled if this is unset.
OWNER_PASSWORD=

# Pricing (all optional; defaults shown). Change in Vercel, then redeploy.
GUEST_FREE_MESSAGES=5
WALLET_FREE_MESSAGES=5
VIP_FREE_MESSAGES=10
MESSAGES_PER_BATCH=20
NOMO_PER_BATCH=0.04
NOMO_PER_IMAGE=0.1
PACK_GARDENER_NOMO=1
PACK_LORD_NOMO=5

# VIP Pass: pay VIP_PRICE_NOMO to the treasury, or burn VIP_PRICE_NOHOES
# $NOHOES to 0x...dEaD. The burn option is disabled until NOHOES_CONTRACT is set.
NOHOES_CONTRACT=
VIP_PRICE_NOMO=1
VIP_PRICE_NOHOES=0.069
VIP_DAYS=30
